# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_URL=postgresql+asyncpg://docsearch:change_me_in_production@postgres:5432/docsearch

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AWS S3 / MinIO ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=docsearch-documents
S3_ARCHIVE_BUCKET_NAME=docsearch-archive
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# ─── AI Providers ───────────────────────────────────────────
# T91 (partial) — set true to refuse (not silently skip) any AI/OCR call
# that would reach an external API. Today this only leaves embeddings
# (bgem3) and OCR (pdfplumber) actually usable air-gapped; LLM and VLM
# have no local provider yet (T90) and will raise on startup/first call.
AIR_GAPPED=false

# ─── T81 — Licensing enforcement (placeholder model, see docs/decisions/T81_licensing_assumptions.md) ───
# saas: usage metered live against a subscription plan (document count/storage)
# on_prem: capacity granted by a signed license file (never phones home)
DEPLOYMENT_MODE=saas
LICENSE_ENFORCEMENT_ENABLED=true
ON_PREM_LICENSE_PATH=/etc/veritasdocs/license.lic
LICENSE_GRACE_PERIOD_DAYS=14

# Provider selection: openai | bgem3 | gemini | cohere | groq (for each role)
AI_LLM_PROVIDER=openai
AI_EMBED_PROVIDER=bgem3
AI_RERANK_PROVIDER=cohere
# pdfplumber | llamaparse | paddleocr — paddleocr (T90) is local (CPU-only,
# no API key, genuine Marathi/Devanagari support), Apache-2.0 licensed
AI_OCR_PROVIDER=pdfplumber

# T22 — VLM extraction (structured facts + table stitching off a rendered
# page image). gemini | openrouter | none. 'none' disables T22 outright;
# ingestion still falls back to chunk-only indexing either way.
AI_VLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1024

# Anthropic (alternative LLM)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Google Gemini (VLM extraction + optional embeddings)
GOOGLE_API_KEY=your_google_api_key
GEMINI_VLM_MODEL=gemini-3.6-flash

# OpenRouter (alternative VLM — proxies any OpenRouter-hosted vision model,
# useful as a fallback when calling Gemini directly hits rate limits/503s)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash

# Cohere (reranker)
COHERE_API_KEY=your_cohere_api_key
COHERE_RERANK_MODEL=rerank-english-v3.0

# LlamaParse (alternative OCR — requires API key)
LLAMAPARSE_API_KEY=llx-...

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "app://dms", "null"]
RATE_LIMIT_PER_USER=60/minute
RATE_LIMIT_PER_TENANT=1000/minute

# ─── Email Webhook ──────────────────────────────────────────
EMAIL_WEBHOOK_ENABLED=true
EMAIL_WEBHOOK_SECRET=generate_with_python_secrets_token_hex_32

# ─── Outbound transactional email (password reset, etc.) ────
# Points at the local GreenMail test server by default (safe for demos —
# no real email delivered). Set real values to deliver to real inboxes.
SMTP_HOST=mailserver
SMTP_PORT=3025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_USERNAME=connector
SMTP_PASSWORD=connector123
SMTP_FROM_EMAIL=noreply@dms.local
SMTP_FROM_NAME=VeritasDocs

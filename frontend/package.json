{
  "name": "dms-ai-document-search",
  "version": "0.1.0",
  "description": "Multi-Tenant AI Document Search Desktop Client",
  "author": "DMS Team <admin@example.com>",
  "homepage": "https://github.com/example/dms",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "predev": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "build": "next build",
    "prebuild": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "start": "next start",
    "lint": "next lint",
    "test:a11y": "playwright test",
    "test:a11y:fast": "node scripts/run_a11y_audit.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "desktop:dev": "electron .",
    "desktop:build": "BUILD_TARGET=desktop next build && electron-builder --linux AppImage deb",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.dms.desktop",
    "productName": "DMS AI Document Search",
    "executableName": "dms-search",
    "icon": "public/stark-icon.png",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "DMS Team <admin@example.com>",
      "category": "Office"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^1.6.0",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.8.0",
    "next": "14",
    "react": "^18",
    "react-dom": "^18",
    "react-pdf": "^9.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^1.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^27.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^14.2.33"
  }
}
